# ========================================================
# Variables de Entorno para Base de Datos (Supabase PostgreSQL)
# ========================================================

# Cadena de conexión obtenida de Supabase:
# Panel Supabase -> Project Settings -> Database -> Connection parameters (URI)
#
# Modo Direct Connection (Puerto 5432):
DATABASE_URL="postgresql://postgres:[TU_CONTRASEÑA]@db.[TU_PROJECT_REF].supabase.co:5432/postgres"

# Modo Transaction Pooler (Puerto 6543 - Recomendado si tu red bloquea puerto 5432):
# DATABASE_URL="postgresql://postgres.[TU_PROJECT_REF]:[TU_CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
